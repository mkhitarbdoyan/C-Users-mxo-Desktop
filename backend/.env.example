# Server
PORT=4000

# Auth — replace with a long random secret before any real use
JWT_SECRET=change-me-to-a-long-random-string

# Postgres (matches docker-compose.yml defaults)
# Start DB: docker compose up -d
# Then:     npx prisma migrate dev && npm run db:seed
DATABASE_URL=postgresql://nclex:nclex@localhost:5432/nclex_rn_prep?schema=public

# Gemini (free tier) — used for post-answer exam explanations
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
