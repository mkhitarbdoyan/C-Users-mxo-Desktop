# Server
PORT=4000

# Auth — replace with a long random secret before any real use
JWT_SECRET=change-me-to-a-long-random-string

# Postgres (matches docker-compose.yml defaults)
# Start DB: docker compose up -d
# Then:     npx prisma migrate dev && npm run db:seed
DATABASE_URL=postgresql://nclex:nclex@localhost:5432/nclex_rn_prep?schema=public

# Google OAuth (Web application client in Google Cloud Console)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Comma-separated deep links the mobile app may use after login
MOBILE_OAUTH_REDIRECT_URIS=nclexrnprep://auth/google
# Allow Expo Go exp://…/auth/google redirect URIs during development (default true)
MOBILE_OAUTH_ALLOW_EXPO_GO=true

# Gemini (free tier) — used for post-answer exam explanations
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
